{
  "name": "note-buddy",
  "version": "1.0.0",
  "description": "Obsidian plugin for OpenCode API integration",
  "main": "main.js",
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun esbuild.config.mjs",
    "build:prod": "bun esbuild.config.mjs production",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src --ext .ts",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "format": "bunx prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "obsidian",
    "plugin",
    "opencode",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "builtin-modules": "^3.3.0",
    "dompurify": "^3.0.9",
    "eslint": "^8.56.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "prettier": "^3.2.5",
    "typescript": "^5.6.2",
    "vitest": "^1.4.0",
    "jsdom": "^24.0.0"
  },
  "dependencies": {
    "ky": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.0"
  }
}
