{
  "name": "note-buddy",
  "version": "1.0.0",
  "description": "AI-powered assistant for your notes",
  "main": "main.js",
  "scripts": {
    "dev": "bun run esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && bun run esbuild.config.mjs production",
    "version": "bun run version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "author": "note-buddy",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.27.2",
    "obsidian": "^1.11.4",
    "tslib": "^2.6.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  },
  "private": true
}
